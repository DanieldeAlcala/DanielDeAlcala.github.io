{% assign repo = include.repository %}

{% if repo.name %}
  {% assign repo_name = repo.name %}
  {% assign repo_url = repo.url %}
  {% assign repo_desc = repo.description %}
  {% assign related_pubs = repo.related_publications %}
{% else %}
  {% assign parts = repo | split: '/' %}
  {% assign repo_name = parts[1] %}
  {% assign repo_url = 'https://github.com/' | append: repo %}
  {% assign repo_desc = nil %}
  {% assign related_pubs = nil %}
{% endif %}

<div class="repo p-2 text-center">
  <a href="{{ repo_url }}" target="_blank" rel="noopener noreferrer">
    <div class="card h-100 hoverable p-3">
      <h3 class="card-title">{{ repo_name }}</h3>
      {% if repo_desc %}
        <p class="card-text">{{ repo_desc }}</p>
      {% endif %}
      {% if related_pubs %}
        <p class="card-text"><strong>Related publications:</strong>
          <ul class="list-unstyled mb-0">
          {% for pub in related_pubs %}
            {% case pub %}
              {% when 'dealcala2025AIdoc' %}
                <li><a href="{{ '/assets/pdf/DocAI.pdf' | relative_url }}">AIDoc (preprint PDF)</a></li>
              {% when 'dealcala2025active' %}
                <li><a href="{{ '/assets/pdf/Active.pdf' | relative_url }}">aMINT (PDF)</a></li>
              {% when 'dealcala2025my' %}
                <li><a href="{{ '/assets/pdf/Is_My_Data.pdf' | relative_url }}">MINT (PDF)</a></li>
              {% else %}
                <li>{{ pub }}</li>
            {% endcase %}
          {% endfor %}
          </ul>
        </p>
      {% endif %}
    </div>
  </a>
</div>

---
---
{% comment %}
  Publication card. The toggles in assets/js/common.js expect the .links row and the hidden
  .bibtex/.abstract blocks to share the same parent (.pub-body).
{% endcomment %}
{%- assign venue_kind = 'main' -%}
{%- if entry.abbr contains '-W' -%}
  {%- assign venue_kind = 'workshop' -%}
{%- elsif entry.abbr contains 'review' or entry.abbr contains 'arXiv' -%}
  {%- assign venue_kind = 'preprint' -%}
{%- endif -%}
<div class="pub-card{% unless entry.preview %} no-thumb{% endunless %}">
  {% if entry.preview and site.enable_publication_thumbnails %}
    <a
      class="pub-thumb"
      {% if entry.pdf %}
        href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}"
      {% endif %}
      aria-label="{{ entry.title | strip_html | escape }}"
    >
      <img
        src="{% if entry.preview contains '://' %}{{ entry.preview }}{% else %}{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}{% endif %}"
        alt=""
        loading="lazy"
      >
    </a>
  {% endif %}

  <div id="{{ entry.key }}" class="pub-body">
    {% if entry.abbr %}
      <span class="venue-badge venue-{{ venue_kind }}">{{ entry.abbr }}</span>
    {% endif %}
    <div class="title">{{ entry.title }}</div>

    <div class="author">
      {%- assign author_array_size = entry.author_array | size -%}
      {%- for author in entry.author_array -%}
        {%- assign author_is_self = false -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- assign coauthor_url = null -%}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {%- if site.data.coauthors[clean_last_name] -%}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {%- if coauthor.firstname contains author.first -%}
              {%- assign coauthor_url = coauthor.url -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- unless forloop.first -%}{%- if author.last == 'others' -%}{% elsif forloop.last -%}{% if author_array_size > 2 %},{% endif %} and {% else %}, {% endif -%}{%- endunless -%}
        {%- if author.last == 'others' -%}
          {{ ' et al.' }}
        {%- elsif author_is_self -%}
          <span class="me">{{ author.first }} {{ author_last_html }}</span>
        {%- elsif coauthor_url -%}
          <a href="{{ coauthor_url }}">{{ author.first }} {{ author_last_html }}</a>
        {%- else -%}
          {{ author.first }} {{ author_last_html }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% if entry.type == 'article' %}
      {% capture entrytype %}{{ entry.journal }}{% endcapture %}
    {% elsif proceedings contains entry.type %}
      {% capture entrytype %}{{ entry.booktitle }}{% endcapture %}
    {% else %}
      {% capture entrytype %}{% endcapture %}
    {% endif %}
    <div class="periodical">
      {{ entrytype | strip }}{% if entry.year %}{% unless entrytype contains entry.year %}, {{ entry.year }}{% endunless %}{% endif %}
    </div>

    {% if entry.tldr %}
      <p class="tldr"><span class="tldr-label">TL;DR</span>{{ entry.tldr }}</p>
    {% endif %}

    <div class="links">
      {% if entry.pdf %}
        <a
          class="pill pill-strong"
          href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}"
          ><i class="fa-solid fa-file-pdf"></i> Paper</a
        >
      {% endif %}
      {% if entry.arxiv %}
        <a class="pill" href="https://arxiv.org/abs/{{ entry.arxiv }}"><i class="fa-solid fa-scroll"></i> arXiv</a>
      {% endif %}
      {% if entry.doi %}
        <a class="pill" href="https://doi.org/{{ entry.doi }}"><i class="fa-solid fa-link"></i> DOI</a>
      {% endif %}
      {% if entry.code %}
        <a class="pill" href="{{ entry.code }}"><i class="fa-brands fa-github"></i> Code</a>
      {% endif %}
      {% if entry.website %}
        <a class="pill" href="{{ entry.website }}"><i class="fa-solid fa-globe"></i> Website</a>
      {% endif %}
      {% if entry.abstract %}
        <a class="abstract pill" role="button"><i class="fa-solid fa-align-left"></i> Abstract</a>
      {% endif %}
      {% if entry.bibtex_show %}
        <a class="bibtex pill" role="button"><i class="fa-solid fa-quote-right"></i> Cite</a>
      {% endif %}
    </div>

    {% if entry.abstract %}
      <div class="abstract hidden"><p>{{ entry.abstract }}</p></div>
    {% endif %}

    {% if entry.bibtex_show %}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}
  </div>
</div>

---
layout: default
---
{% assign home = site.data.home %}
<div class="home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-role">{{ home.role }}</p>
      <ul class="hero-affil">
        {% for a in home.affiliations %}
          <li>
            <span class="logo-chip"><img src="{{ a.logo | prepend: '/assets/img/logos/' | relative_url }}" alt=""></span>
            <span>{{ a.text }}</span>
          </li>
        {% endfor %}
      </ul>
      <div class="hero-links">
        {% for l in home.links %}
          <a class="pill" href="{% if l.url contains '://' or l.url contains 'mailto:' %}{{ l.url }}{% else %}{{ l.url | relative_url }}{% endif %}">
            <i class="{{ l.icon }}"></i> {{ l.label }}
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="hero-photo">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Photo of {{ site.first_name }} {{ site.last_name }}">
    </div>
  </section>

  <!-- About -->
  <section class="home-section reveal" id="about">
    <h2 class="section-title">About</h2>
    <div class="about-text">{{ content }}</div>
    <ul class="tags">
      {% for t in home.tags %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </section>

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section reveal" id="news">
      <h2 class="section-title">News</h2>
      {% include news.liquid limit=true %}
      <a class="more-link" href="{{ '/news/' | relative_url }}">All news <i class="fa-solid fa-arrow-right"></i></a>
    </section>
  {% endif %}

  <!-- Projects -->
  <section class="home-section reveal" id="projects">
    <h2 class="section-title">Featured projects</h2>
    <div class="proj-grid">
      {% for p in home.projects %}
        <a class="proj-card" href="{% if p.url contains '://' %}{{ p.url }}{% else %}{{ p.url | relative_url }}{% endif %}">
          <div class="proj-img"><img src="{{ p.img | relative_url }}" alt="" loading="lazy"></div>
          <div class="proj-body">
            <div class="proj-head">
              <h3>{{ p.title }}</h3>
              <span class="proj-status">{{ p.status }}</span>
            </div>
            <p>{{ p.text }}</p>
            <div class="proj-tags">
              {% for t in p.tags %}<span>{{ t }}</span>{% endfor %}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>

  <!-- Selected publications -->
  {% if page.selected_papers %}
    <section class="home-section reveal" id="publications">
      <h2 class="section-title">Selected publications</h2>
      {% include selected_papers.liquid %}
      <a class="more-link" href="{{ '/publications/' | relative_url }}">All publications <i class="fa-solid fa-arrow-right"></i></a>
    </section>
  {% endif %}

  <!-- Experience -->
  <section class="home-section reveal" id="experience">
    <h2 class="section-title">Experience</h2>
    <ol class="timeline">
      {% for e in home.experience %}
        <li class="tl-item">
          <span class="logo-chip tl-logo"><img src="{{ e.logo | prepend: '/assets/img/logos/' | relative_url }}" alt=""></span>
          <div class="tl-content">
            <div class="tl-head">
              <h3>{{ e.org }}</h3>
              <span class="tl-date">{{ e.date }}</span>
            </div>
            <div class="tl-role">
              {{ e.role }}{% if e.host %} <span class="muted">· {{ e.host }}</span>{% endif %}
              {% if e.place %}<span class="tl-place"><i class="fa-solid fa-location-dot"></i> {{ e.place }}</span>{% endif %}
            </div>
            <p>{{ e.text }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </section>

  <!-- Education -->
  <section class="home-section reveal" id="education">
    <h2 class="section-title">Education</h2>
    <ol class="timeline">
      {% for e in home.education %}
        <li class="tl-item">
          <span class="logo-chip tl-logo"><img src="{{ e.logo | prepend: '/assets/img/logos/' | relative_url }}" alt=""></span>
          <div class="tl-content">
            <div class="tl-head">
              <h3>{{ e.degree }}</h3>
              <span class="tl-date">{{ e.date }}</span>
            </div>
            <div class="tl-role">{{ e.org }}</div>
            {% if e.text %}<p>{{ e.text }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </section>
</div>

<script>
  (function () {
    if (!("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("js-reveal");
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add("visible");
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px" }
    );
    document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });
  })();
</script>
